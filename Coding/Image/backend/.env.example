# Axiom-I Backend Configuration
# Copy this file to .env and configure as needed.
# All environment variables are prefixed with AXIOM_ as defined in config.py.

# Project name
AXIOM_PROJECT_NAME="Axiom-I Media Forensics"

# Version of the API
AXIOM_VERSION="1.0.0"

# API route prefix
AXIOM_API_V1_STR="/api/v1"

# Device to run inference on: "cpu", "cuda", "mps", etc.
AXIOM_DEVICE="cpu"

# Enable debugging mode (logs, error tracebacks)
AXIOM_DEBUG=false

# Host IP to bind the FastAPI app
AXIOM_API_HOST="0.0.0.0"

# Port to bind the FastAPI app
AXIOM_API_PORT=8000

# Whether to download the ViT classifier model automatically from HuggingFace
AXIOM_ALLOW_MODEL_DOWNLOAD=false

# HuggingFace model path for deepfake classification
AXIOM_VIT_MODEL_NAME="prithivMLmods/Deep-Fake-Detector-v2-Model"

# Allowed CORS origins (JSON array or list format, e.g. ["http://localhost:3000"])
AXIOM_ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Maximum uploaded file size (default: 50MB)
AXIOM_MAX_UPLOAD_SIZE=52428800

# Maximum allowed image pixel count to prevent memory exhaustion (default: 20M pixels)
AXIOM_MAX_IMAGE_PIXELS=20000000

# Deployment Mode: "local" (uses local JSON files) or "host" (uses HuggingFace private dataset)
AXIOM_MODE="local"

# HuggingFace API Token (required when AXIOM_MODE="host" for write permissions)
AXIOM_HF_TOKEN=""

# HuggingFace private dataset path (required when AXIOM_MODE="host", e.g., "username/dataset-name")
AXIOM_HF_DATASET_PATH=""
